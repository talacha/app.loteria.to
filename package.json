{
  "name": "app-loteria-to",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -b --noEmit && tsc -p api --noEmit && tsc -p tests/api --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "validate-content": "node scripts/run-optional.mjs scripts/validate-content.ts",
    "copy-lint": "node scripts/run-optional.mjs scripts/copy-lint.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm validate-content && pnpm copy-lint"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/supabase-js": "^2.118.0",
    "@upstash/qstash": "^2.12.1",
    "@upstash/redis": "^1.39.0",
    "i18next": "^26.5.11",
    "i18next-icu": "^2.6.1",
    "idb": "^8.0.4",
    "intl-messageformat": "^12.1.4",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "react-router": "^8.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/node": "^27.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jose": "^6.2.13",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1"
  },
  "packageManager": "pnpm@11.5.1"
}
