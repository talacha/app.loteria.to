{
  "$description": "Feria de noche design tokens — single source of truth. Derived from docs/design/look-and-feel.pdf and the Claude Design canvas. src/app/theme/tokens.css must define every token below as a CSS custom property named --<group>-<name> (see docs/DESIGN.md §2). Edit here first.",
  "color": {
    "night": { "$value": "#1E2142", "$description": "App ground" },
    "night-raised": { "$value": "#2A2E58", "$description": "Panels on the ground (call panel, hints, caller side cards)" },
    "night-line": { "$value": "#45497F", "$description": "Dividers and progress-bar track on night" },
    "night-dash": { "$value": "#6E6AA6", "$description": "Dashed outline of neutral hint panels" },
    "ink": { "$value": "#16182F", "$description": "Every border; text on paper/maiz/review" },
    "paper": { "$value": "#FFF6E5", "$description": "Card faces; text on night" },
    "white": { "$value": "#FFFFFF", "$description": "Tabla cells, glyph wells, QR ground" },
    "shadow": { "$value": "#0C0D1E", "$description": "Hard drop shadow colour" },
    "muted-on-night": { "$value": "#C9C3E6", "$description": "Secondary text on night (≥ 7:1)" },
    "muted-on-paper": { "$value": "#4A4766", "$description": "Secondary text on paper (≥ 7:1)" },
    "maiz": { "$value": "#FFC233", "$description": "Primary action, highlights, room-code tiles, self tile, winning-line cells" },
    "maiz-soft": { "$value": "#FFE08A", "$description": "Review tag fill ('palabra en revisión')" },
    "rosa": { "$value": "#E5177E", "$description": "Español; ¡Lotería! surface" },
    "jade": { "$value": "#0E9F7E", "$description": "Náhuatl; correct; connected" },
    "jade-soft": { "$value": "#C9F2E4", "$description": "Correct choice tile fill" },
    "cielo": { "$value": "#2F6FE4", "$description": "English" },
    "maya": { "$value": "#7A4BD6", "$description": "Maya yucateco" },
    "quechua": { "$value": "#C2410C", "$description": "Quechua (Cusco-Collao)" },
    "chile": { "$value": "#E2412B", "$description": "Card art only — never UI state" },
    "bean": { "$value": "#6B2F23", "$description": "Bean (frijolito) marker" },
    "bean-dark": { "$value": "#4A1F16", "$description": "Bean inner shade" },
    "bean-light": { "$value": "#8A4A3A", "$description": "Bean highlight" },
    "disabled-on-night": { "$value": "#3A3E6A", "$description": "Dimmed/wrong choice tile" }
  },
  "lang": {
    "nah": { "$value": "{color.jade}" },
    "yua": { "$value": "{color.maya}" },
    "quz": { "$value": "{color.quechua}" },
    "es": { "$value": "{color.rosa}" },
    "en": { "$value": "{color.cielo}" }
  },
  "font": {
    "display": { "$value": "'Bricolage Grotesque', 'Atkinson Hyperlegible', system-ui, sans-serif", "$description": "Weights 600/800. Titles, words, codes, buttons" },
    "ui": { "$value": "'Atkinson Hyperlegible', system-ui, sans-serif", "$description": "Weights 400/700. Everything else" }
  },
  "text": {
    "xs": { "$value": "11px", "$description": "Tags, tabla labels min (never smaller)" },
    "sm": { "$value": "13px", "$description": "Captions, meta" },
    "md": { "$value": "15px", "$description": "Body small" },
    "base": { "$value": "16px", "$description": "Body" },
    "lg": { "$value": "18px", "$description": "Wordmark, feedback title" },
    "xl": { "$value": "22px", "$description": "Card titles, buttons" },
    "2xl": { "$value": "30px", "$description": "Screen titles (phone)" },
    "3xl": { "$value": "36px", "$description": "Hero title (phone)" },
    "word": { "$value": "38px", "$description": "Called word on phone" },
    "code": { "$value": "40px", "$description": "Room-code tile glyph" },
    "hero": { "$value": "64px", "$description": "¡Lotería! and caller-screen words" }
  },
  "space": {
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" }
  },
  "radius": {
    "xs": { "$value": "10px", "$description": "Tabla cells (small)" },
    "sm": { "$value": "12px", "$description": "Tabla cells, code tiles, glyph wells" },
    "md": { "$value": "16px", "$description": "Inputs, chips, feedback strip" },
    "lg": { "$value": "20px", "$description": "Choice tiles, tabla board" },
    "xl": { "$value": "24px", "$description": "Cards, panels" },
    "pill": { "$value": "999px", "$description": "Pills and tags" }
  },
  "border": {
    "thick": { "$value": "3px solid #16182F", "$description": "Cards, buttons, tiles, panels" },
    "thin": { "$value": "2px solid #16182F", "$description": "Pills, tags, tabla cells, small wells" },
    "dashed": { "$value": "2px dashed #6E6AA6", "$description": "Neutral hint panels on night" }
  },
  "shadow": {
    "hard": { "$value": "0 5px 0 #0C0D1E", "$description": "Default lift for cards, buttons, tiles" },
    "hard-sm": { "$value": "0 4px 0 #0C0D1E", "$description": "Small buttons, glyph tiles" },
    "hard-lg": { "$value": "0 6px 0 #0C0D1E", "$description": "Hero cards (room code, win tabla)" }
  },
  "size": {
    "tap": { "$value": "44px", "$description": "Minimum touch target" },
    "button": { "$value": "60px", "$description": "Primary button height" },
    "choice": { "$value": "96px", "$description": "Minimum choice-tile height" },
    "phone": { "$value": "390px", "$description": "Design width (mobile first)" },
    "tablet": { "$value": "768px" },
    "laptop": { "$value": "1280px" }
  },
  "motion": {
    "press": { "$value": "translateY(3px)", "$description": "Pressed/disabled: shadow removed + this offset" },
    "lift": { "$value": "translateY(-2px)", "$description": "Selected card" }
  }
}
